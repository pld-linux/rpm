+  /build/RPMS/noarch/colorghost-1.0-1.noarch.rpm \
+  /build/RPMS/x32/colorconflict-1.0-1.x32.rpm
+runroot rpm -q --qf "[[%{filestates:fstate},]]\n" colorconflict.x32 colorconflict.i686
